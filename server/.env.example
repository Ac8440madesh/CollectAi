# --- Server config ---
PORT=4000
NODE_ENV=development

# --- Database (used from Phase 1) ---
# Supabase: Project Settings → Database → Connection string.
# Prefer the "Session pooler" string (IPv4-friendly), of the form:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Auth (used from Phase 1) ---
# Any long random string (32+ chars). Generate one, e.g. in PowerShell:
#   [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- LLM ---
# Provider + model switch so we can move between the Claude API and the Gemini API.
LLM_PROVIDER=anthropic        # or gemini
LLM_MODEL=
LLM_API_KEY=
# Default is mock so the app and tests run with NO API key. Set to "live" to call the real API.
LLM_MODE=mock                 # or live

# --- Mailer (dry-run is default; used from Phase 3) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
